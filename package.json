{
  "name": "resifix",
  "version": "0.1.0",
  "private": true,
  "description": "Maintenance management and accountability platform for student halls and hostels",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:check": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "studio": "prisma studio",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^17.14.0",
    "prettier": "^3.6.0",
    "prisma": "^6.19.0"
  }
}
