# Copy to .env (never commit .env). Values below match docker-compose.yml.

NODE_ENV=development
PORT=3000

# PostgreSQL (docker compose up -d db)
DATABASE_URL=postgresql://resifix:resifix@localhost:5432/resifix?schema=public

# JWT — use a long random string outside local dev
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# OTP. In development the code is always OTP_DEV_CODE and is logged to the console.
OTP_DEV_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Log level: debug | info | warn | error
LOG_LEVEL=info
