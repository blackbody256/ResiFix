# Copy to .env (never commit .env). Values below match docker-compose.yml for local dev.

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://resifix:resifix@localhost:5432/resifix?schema=public

# JWT: use a long random string outside local dev (required in production)
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d

# OTP. Outside production the code is always OTP_DEV_CODE and is logged by the API.
OTP_DEV_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# Redis + BullMQ. RUN_WORKER_INLINE=true runs the queue worker inside the API process
# (local dev). Docker sets it to false and runs the separate `worker` service.
REDIS_URL=redis://localhost:6379
RUN_WORKER_INLINE=true
AUTO_CLOSE_HOURS=48

# S3-compatible storage (MinIO locally; console on http://localhost:9001)
S3_ENDPOINT=http://localhost:9000
# Endpoint browsers use for presigned links (defaults to S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=resifix-photos
S3_ACCESS_KEY=resifix
S3_SECRET_KEY=resifix-secret
S3_FORCE_PATH_STYLE=true
PHOTO_URL_TTL_SECONDS=900

# Web Push (VAPID). Generate with: npm run vapid:generate -w server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@resifix.local

# Africa's Talking SMS (OTP + notification fallback). Empty = log instead of send.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# Sentry (empty = disabled). VITE_ vars are baked into the client at build time.
SENTRY_DSN=
VITE_SENTRY_DSN=
